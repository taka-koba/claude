# Anthropic の APIキー（https://console.anthropic.com で発行）
ANTHROPIC_API_KEY=

# 使うモデル（省略時 claude-opus-5-5）
# CLAUDE_MODEL=claude-opus-5-5

# サーバーのポート（Tailscale serve の転送先と合わせる）
# PORT=8787

# データの保存先（SQLite）
# DB_PATH=data/konkatsu.db

# 開発用PCでは dev にする（start.bat がローカルで起動せず、本番のURLを開くだけになる）
# ROLE=dev
# PROD_URL=https://pc-g-taka.tail52ce93.ts.net

# 常時起動のPCが自動更新で追いかけるブランチ（省略時 main）
# DEPLOY_BRANCH=main
